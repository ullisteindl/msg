@prefix : <https://iccb-cologne.org/groups/lehmann-lab/msg#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://iccb-cologne.org/groups/lehmann-lab/msg#> .

<https://iccb-cologne.org/groups/lehmann-lab/msg> rdf:type owl:Ontology ;
                                                   rdfs:comment "This is an ontology describing what mutational signatures are, which properties they have, and how they interact with genomic information, treatments, and cancer types"@en ;
                                                   rdfs:label "msg"@en ,
                                                              "mutational signature ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/ns/prov#category
<http://www.w3.org/ns/prov#category> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#component
<http://www.w3.org/ns/prov#component> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#inverse
<http://www.w3.org/ns/prov#inverse> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#qualifiedForm
<http://www.w3.org/ns/prov#qualifiedForm> rdf:type owl:AnnotationProperty .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_has_evidence_strength
:COSMIC_has_evidence_strength rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/ns/prov#hadPrimarySource
<http://www.w3.org/ns/prov#hadPrimarySource> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                                             rdfs:domain <http://www.w3.org/ns/prov#Entity> ,
                                                         :Observation ;
                                             rdfs:range <http://www.w3.org/ns/prov#Entity> ,
                                                        :Evidence ;
                                             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
                                             rdfs:label "hadPrimarySource" ;
                                             <http://www.w3.org/ns/prov#category> "expanded" ;
                                             <http://www.w3.org/ns/prov#component> "derivations" ;
                                             <http://www.w3.org/ns/prov#inverse> "wasPrimarySourceOf" ;
                                             <http://www.w3.org/ns/prov#qualifiedForm> <http://www.w3.org/ns/prov#PrimarySource> ,
                                                                                       <http://www.w3.org/ns/prov#qualifiedPrimarySource> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://www.w3.org/ns/prov#hadPrimarySource> ;
   owl:annotatedProperty rdfs:subPropertyOf ;
   owl:annotatedTarget <http://www.w3.org/ns/prov#wasDerivedFrom> ;
   rdfs:comment "hadPrimarySource property is a particular case of wasDerivedFrom (see http://www.w3.org/TR/prov-dm/#term-original-source) that aims to give credit to the source that originated some information."
 ] .


###  http://www.w3.org/ns/prov#wasDerivedFrom
<http://www.w3.org/ns/prov#wasDerivedFrom> rdf:type owl:ObjectProperty .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_aetiology
:COSMIC_aetiology rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :COSMIC_obj_properties_with_evidence_strength ;
                  rdfs:domain :MutationalSignature ;
                  rdfs:range :Etiology .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_experimental_evidence
:COSMIC_experimental_evidence rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :COSMIC_obj_properties_with_evidence_strength ;
                              rdfs:comment "points to the doi of a study"@en ;
                              rdfs:label "COSMIC_experimental_evidence"@en ;
                              :COSMIC_has_evidence_strength [ rdf:type :COSMIC_evidence_strength
                                                            ] .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_experimental_validation_species
:COSMIC_experimental_validation_species rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf :COSMIC_obj_properties_with_evidence_strength ;
                                        rdfs:comment "e.g. Yeast, Mice, etc."@en ;
                                        rdfs:label "COSMIC_experimental_validation_species"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_experimentally_validated
:COSMIC_experimentally_validated rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :COSMIC_obj_properties_with_evidence_strength .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_first_included_in
:COSMIC_first_included_in rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :COSMIC_properties ;
                          rdfs:domain :Observation ;
                          rdfs:range :COSMIC_version .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_has_version
:COSMIC_has_version rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :COSMIC_properties ;
                    rdfs:domain :Observation ;
                    rdfs:range :COSMIC_version .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_identification_study
:COSMIC_identification_study rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :COSMIC_properties .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_obj_properties_with_evidence_strength
:COSMIC_obj_properties_with_evidence_strength rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf :COSMIC_properties ;
                                              rdfs:comment "Abstract class for all properties that have evidence strength"@en ;
                                              rdfs:label "COSMIC_obj_properties_with_evidence_strength"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_properties
:COSMIC_properties rdf:type owl:ObjectProperty ;
                   rdfs:domain :Observation ;
                   rdfs:comment "For all properties contained in the summary section"@en ;
                   rdfs:label "COSMIC_properties"@en ;
                   :COSMIC_has_evidence_strength [ rdf:type :COSMIC_evidence_strength
                                                 ] .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_technically_validated
:COSMIC_technically_validated rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :COSMIC_obj_properties_with_evidence_strength .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_uses_sample
:COSMIC_uses_sample rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :COSMIC_properties ;
                    rdfs:domain :MutationalSignature ;
                    rdfs:range :Sample .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#causes
:causes rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :is_associated_with ;
        rdfs:domain :Etiology ;
        rdfs:range :Tumor ;
        owl:propertyDisjointWith :occurs_with ;
        rdfs:comment "An etiology causes cancer"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#contributes_to
:contributes_to rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :Mutation ,
                            :Sample .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_immediate_part
:has_immediate_part rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :has_part .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_median_mutations_in
:has_median_mutations_in rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :has_mutations ;
                         rdfs:range :MutationalSignature ;
                         rdfs:label "has_median_mutations_in"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_mutations
:has_mutations rdf:type owl:ObjectProperty ;
               rdfs:domain :Species ,
                           :Tumor .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_part
:has_part rdf:type owl:ObjectProperty ;
          owl:inverseOf :part_of ;
          rdfs:domain :MutationalSignature ;
          rdfs:range :MutationProbability ;
          rdfs:comment """Implemented according to

https://www.w3.org/2001/sw/BestPractices/OEP/SimplePartWhole/"""@en ;
          rdfs:label "has_part"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_signature
:has_signature rdf:type owl:ObjectProperty ;
               rdfs:domain :Sample ,
                           :Tumor ;
               rdfs:range :MutationalSignature ;
               rdfs:comment """e.g. 80% of BiliaryAdenoCa tumors have signature sbs1, 
Sample x has signature sbs5"""@en ;
               rdfs:label "has_signature"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_signature_proportion
:has_signature_proportion rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :has_signature ;
                          rdfs:label "has_signature_proportion"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#has_species
:has_species rdf:type owl:ObjectProperty ;
             rdfs:domain :Sample ;
             rdfs:range :Species ;
             rdfs:label "has_species"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#is_associated_with
:is_associated_with rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdf:type owl:SymmetricProperty ;
                    rdfs:domain :MutationalSignature ;
                    rdfs:range :Etiology ,
                               :Tumor ;
                    rdfs:comment "relation defined for aetiologies, cancers, and signatures"@en ;
                    rdfs:label "is_associated_with"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#is_at
:is_at rdf:type owl:ObjectProperty ;
       rdfs:domain :Mutation ,
                   :Tumor ;
       rdfs:range :BodyPart ,
                  :Location .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#occurs_with
:occurs_with rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :is_associated_with ;
             rdfs:domain :Etiology ;
             rdfs:range :MutationalSignature .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#part_of
:part_of rdf:type owl:ObjectProperty .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#part_of_immediate
:part_of_immediate rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :part_of .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#treats
:treats rdf:type owl:ObjectProperty ;
        rdfs:domain :Treatment ;
        rdfs:range :Tumor ;
        rdfs:comment "a treatment treats a sickness"@en ;
        rdfs:label "treats"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdfs:domain :Sample ;
                    rdfs:range xsd:string .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_NGS_technique
:COSMIC_NGS_technique rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :COSMIC_properties_with_evidence_strength ;
                      rdfs:range xsd:string ;
                      rdfs:comment "e.g. WES & WGS"@en ;
                      rdfs:label "COSMIC_NGS_technique"@en ;
                      :COSMIC_has_evidence_strength [ rdf:type :COSMIC_evidence_strength
                                                    ] .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_aetiology
:COSMIC_aetiology rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :COSMIC_properties_with_evidence_strength ;
                  rdfs:range rdfs:Literal .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_boolean
:COSMIC_boolean rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :COSMIC_properties_with_evidence_strength ;
                rdfs:range xsd:boolean .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_data_properties
:COSMIC_data_properties rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_different_variant_callers
:COSMIC_different_variant_callers rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf :COSMIC_boolean ;
                                  rdfs:range xsd:boolean ;
                                  rdfs:comment "Variant callers are the softwares to label certain parts of the genome. If more than one are used this is relevant since they may not have uniform results"@en ;
                                  rdfs:label "COSMIC_different_variant_callers"@en ;
                                  :COSMIC_has_evidence_strength [ rdf:type :COSMIC_evidence_strength
                                                                ] .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_extended_contextual_enrichment
:COSMIC_extended_contextual_enrichment rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf :COSMIC_properties_with_evidence_strength ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "For comments like 'Two forms: pyrimidine or purine at -2 bp'"@en ;
                                       rdfs:label "COSMIC_extended_contextual_enrichment"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_multiple_sequencing_centres
:COSMIC_multiple_sequencing_centres rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf :COSMIC_boolean ;
                                    rdfs:range xsd:boolean ;
                                    rdfs:label "COSMIC_multiple_sequencing_centers"@en ,
                                               "COSMIC_multiple_sequencing_centres"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_properties_with_evidence_strength
:COSMIC_properties_with_evidence_strength rdf:type owl:DatatypeProperty ;
                                          rdfs:subPropertyOf :COSMIC_data_properties ;
                                          rdfs:comment "superclass to avoid having to add evidence strength parameters everywhere"@en ;
                                          rdfs:label "COSMIC_properties_with_evidence_strength"@en ;
                                          :COSMIC_has_evidence_strength [ rdf:type :COSMIC_evidence_strength
                                                                        ] .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_replicated
:COSMIC_replicated rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :COSMIC_boolean ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "COSMIC_replicated"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_support
:COSMIC_support rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :COSMIC_boolean ;
                rdfs:comment "e.g. Experimental confirmation"@en ;
                rdfs:label "COSMIC_support"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#COSMIC_validated_in_orthogonal_techniques
:COSMIC_validated_in_orthogonal_techniques rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf :COSMIC_boolean ;
                                           rdfs:range xsd:boolean ;
                                           rdfs:label "COSMIC_validated_in_orthogonal_techniques"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasAssociationValue
:hasAssociationValue rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasValue .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasEvidenceStrength
:hasEvidenceStrength rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasValue .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasFloatValue
:hasFloatValue rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasValue ;
               rdfs:range xsd:float .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasMedianMutationPerMb
:hasMedianMutationPerMb rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf :hasValue .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasName
:hasName rdf:type owl:DatatypeProperty .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasOrigin
:hasOrigin rdf:type owl:DatatypeProperty ;
           rdfs:domain :Sample ;
           rdfs:range xsd:string ;
           rdfs:comment "Where does this sample come from? Is it a reference genome, an actual sample, etc?"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasProbabilityValue
:hasProbabilityValue rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasFloatValue ;
                     rdfs:domain [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasProbabilityValue ;
                                   owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasProbabilityValue ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ;
                     rdfs:label "hasProbabilityValue"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasProportion
:hasProportion rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasFloatValue .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :Observation ;
          rdfs:range xsd:decimal ;
          rdfs:label "hasValue"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-A.A
:A.C-A.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-A.C
:A.C-A.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-A.G
:A.C-A.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-A.T
:A.C-A.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-G.A
:A.C-G.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-G.C
:A.C-G.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-G.G
:A.C-G.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-G.T
:A.C-G.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-T.A
:A.C-T.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-T.C
:A.C-T.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-T.G
:A.C-T.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.C-T.T
:A.C-T.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-A.A
:A.T-A.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-A.C
:A.T-A.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-A.G
:A.T-A.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-A.T
:A.T-A.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-C.A
:A.T-C.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-C.C
:A.T-C.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-C.G
:A.T-C.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-C.T
:A.T-C.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-G.A
:A.T-G.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-G.C
:A.T-G.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-G.G
:A.T-G.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#A.T-G.T
:A.T-G.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#BodyPart
:BodyPart rdf:type owl:Class ;
          rdfs:comment "Like breast, kidney, head and neck, colon, etc. Maps to NCIT"@en ;
          rdfs:label "BodyPart"@en .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-A.A
:C.C-A.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-A.C
:C.C-A.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-A.G
:C.C-A.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-A.T
:C.C-A.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-G.A
:C.C-G.A rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-G.C
:C.C-G.C rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-G.G
:C.C-G.G rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


###  https://iccb-cologne.org/groups/lehmann-lab/msg#C.C-G.T
:C.C-G.T rdf:type owl:Class ;
         rdfs:subClassOf :SBS_probability .


