mso:hasFloatValue a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf mso:hasValue .

mso:hasProbabilityValue a owl:DatatypeProperty ;
    rdfs:label "hasProbabilityValue"@en ;
    rdfs:domain [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:float ;
            owl:onProperty mso:hasProbabilityValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:float ;
            owl:onProperty mso:hasProbabilityValue ] ;
    rdfs:subPropertyOf mso:hasFloatValue .

mso:hasValue a owl:DatatypeProperty ;
    rdfs:label "hasValue"@en ;
    rdfs:domain mso:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

mso:has_mutations a owl:ObjectProperty ;
    rdfs:domain mso:Species,
        mso:Tumor ;
    rdfs:type mso:has_mutations .

mso:has_signature a owl:ObjectProperty ;
    rdfs:label "has_signature"@en ;
    rdfs:comment """e.g. 80% of BiliaryAdenoCa tumors have signature sbs1, 
Sample x has signature sbs5"""@en ;
    rdfs:domain mso:Sample,
        mso:Tumor ;
    rdfs:range mso:MutationalSignature ;
    rdfs:type mso:has_signature .

mso:is_associated_with a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is_associated_with"@en ;
    rdfs:comment "relation defined for aetiologies, cancers, and signatures"@en ;
    rdfs:domain mso:MutationalSignature ;
    rdfs:range mso:Etiology,
        mso:Tumor ;
    rdfs:subPropertyOf owl:topObjectProperty .

mso:part_of a owl:ObjectProperty .

mso:COSMIC_NGS_technique a owl:DatatypeProperty,
        mso:COSMIC_NGS_technique ;
    rdfs:label "COSMIC_NGS_technique"@en ;
    rdfs:comment "e.g. WES & WGS"@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf mso:COSMIC_properties_with_evidence_strength ;
    mso:COSMIC_has_evidence_strength [ a mso:COSMIC_evidence_strength ] .

mso:COSMIC_different_variant_callers a owl:DatatypeProperty,
        mso:COSMIC_different_variant_callers ;
    rdfs:label "COSMIC_different_variant_callers"@en ;
    rdfs:comment "Variant callers are the softwares to label certain parts of the genome. If more than one are used this is relevant since they may not have uniform results"@en ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf mso:COSMIC_boolean ;
    mso:COSMIC_has_evidence_strength [ a mso:COSMIC_evidence_strength ] .

mso:COSMIC_extended_contextual_enrichment a owl:DatatypeProperty,
        mso:COSMIC_extended_contextual_enrichment ;
    rdfs:label "COSMIC_extended_contextual_enrichment"@en ;
    rdfs:comment "For comments like 'Two forms: pyrimidine or purine at -2 bp'"@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf mso:COSMIC_properties_with_evidence_strength .

mso:COSMIC_multiple_sequencing_centres a owl:DatatypeProperty,
        mso:COSMIC_multiple_sequencing_centres ;
    rdfs:label "COSMIC_multiple_sequencing_centers"@en,
        "COSMIC_multiple_sequencing_centres"@en ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf mso:COSMIC_boolean .

mso:COSMIC_replicated a owl:DatatypeProperty,
        mso:COSMIC_replicated ;
    rdfs:label "COSMIC_replicated"@en ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf mso:COSMIC_boolean .

obo:NCIT_C12438 rdfs:label "CNS"@en ;
    rdfs:type mso:BodyPart .

mso:COSMIC_aetiology a owl:DatatypeProperty,
        owl:ObjectProperty,
        mso:COSMIC_aetiology ;
    rdfs:label "COSMIC_aetiology"@en ;
    rdfs:comment "Implementing this as a string for now, until I have etiologies implemented"@en ;
    rdfs:domain mso:MutationalSignature ;
    rdfs:range rdfs:Literal,
        mso:Etiology ;
    rdfs:subPropertyOf mso:COSMIC_obj_properties_with_evidence_strength,
        mso:COSMIC_properties_with_evidence_strength .

mso:COSMIC_evidence_strength_artifact-evidence rdfs:type mso:COSMIC_evidence_strength .

mso:COSMIC_experimental_evidence a owl:ObjectProperty,
        mso:COSMIC_experimental_evidence ;
    rdfs:label "COSMIC_experimental_evidence"@en ;
    rdfs:comment "points to the doi of a study"@en ;
    rdfs:subPropertyOf mso:COSMIC_obj_properties_with_evidence_strength ;
    mso:COSMIC_has_evidence_strength [ a mso:COSMIC_evidence_strength ] .

mso:COSMIC_experimental_validation_species a owl:ObjectProperty,
        mso:COSMIC_experimental_validation_species ;
    rdfs:label "COSMIC_experimental_validation_species"@en ;
    rdfs:comment "e.g. Yeast, Mice, etc."@en ;
    rdfs:subPropertyOf mso:COSMIC_obj_properties_with_evidence_strength .

mso:COSMIC_properties_with_evidence_strength a owl:DatatypeProperty ;
    rdfs:label "COSMIC_properties_with_evidence_strength"@en ;
    rdfs:comment "superclass to avoid having to add evidence strength parameters everywhere"@en ;
    rdfs:subPropertyOf mso:COSMIC_data_properties ;
    mso:COSMIC_has_evidence_strength [ a mso:COSMIC_evidence_strength ] .

mso:COSMIC_support a owl:DatatypeProperty,
        mso:COSMIC_support ;
    rdfs:label "COSMIC_support"@en ;
    rdfs:comment "e.g. Experimental confirmation"@en ;
    rdfs:subPropertyOf mso:COSMIC_boolean .

mso:Etiology a owl:Class .

mso:SBS_v3.4_sbs10a rdfs:label "sbs10a"@en ;
    rdfs:type mso:SBS ;
    mso:COSMIC_NGS_technique_valid-evidence "WES & WGS"@en ;
    mso:COSMIC_aetiology_valid-evidence "POLE exonuclease domain mutation"@en ;
    mso:COSMIC_different_variant_callers_valid-evidence true ;
    mso:COSMIC_experimental_evidence_valid-evidence <https://doi.org/10.1172/jci122095> ;
    mso:COSMIC_experimental_validation_species_valid-evidence "Mouse"@en ;
    mso:COSMIC_first_included_in mso:COSMIC_version_v3 ;
    mso:COSMIC_has_version mso:COSMIC_version_v3.4 ;
    mso:COSMIC_identification_study <https://doi.org/10.1038/s41586-020-1943-3> ;
    mso:COSMIC_multiple_sequencing_centres_valid-evidence true ;
    mso:COSMIC_replicated_valid-evidence true ;
    mso:COSMIC_support_valid-evidence "Experimental confirmation"@en ;
