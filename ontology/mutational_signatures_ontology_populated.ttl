    mso:has_proportion "1.0"^^xsd:float .

mso:has_species a owl:ObjectProperty ;
    rdfs:label "has_species"@en ;
    rdfs:domain mso:Sample ;
    rdfs:range mso:Species .

mso:is_at a owl:ObjectProperty ;
    rdfs:domain mso:Mutation,
        mso:Tumor ;
    rdfs:range mso:BodyPart,
        mso:Location .

mso:part_of_immediate a owl:ObjectProperty ;
    rdfs:subPropertyOf mso:part_of .

mso:treats a owl:ObjectProperty ;
    rdfs:label "treats"@en ;
    rdfs:comment "a treatment treats a sickness"@en ;
    rdfs:domain mso:Treatment ;
    rdfs:range mso:Tumor .

