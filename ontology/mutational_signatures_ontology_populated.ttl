mso:COSMIC_boolean a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf mso:COSMIC_properties_with_evidence_strength .

mso:COSMIC_obj_properties_with_evidence_strength a owl:ObjectProperty ;
    rdfs:label "COSMIC_obj_properties_with_evidence_strength"@en ;
    rdfs:comment "Abstract class for all properties that have evidence strength"@en ;
    rdfs:subPropertyOf mso:COSMIC_properties .

mso:COSMIC_properties a owl:ObjectProperty ;
    rdfs:label "COSMIC_properties"@en ;
