mso:SBS a owl:Class ;
    rdfs:label "SBS Signature" ;
    rdfs:comment "This signature type covers single base pair mutations"@en ;
    rdfs:subClassOf mso:MutationalSignature .

mso:COSMIC_version_v3.4 rdfs:label "v3.4"@en ;
    rdfs:type mso:COSMIC_version .

mso:SBS_probability a owl:Class ;
    rdfs:label "SBS_probability"@en ;
    rdfs:comment "e.g. A[C>A]A"@en ;
    rdfs:subClassOf mso:MutationProbability .

