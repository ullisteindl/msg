mso:SV_probability a owl:Class ;
    rdfs:label "SV_probability"@en ;
    rdfs:subClassOf mso:MutationProbability .

mso:Sample_v3.4_GRCh37 rdfs:label "GRCh37"@en ;
    rdfs:type mso:Sample ;
    mso:has_species obo:NCIT_C14225 .

mso:Sample_v3.4_GRCh38 rdfs:label "GRCh38"@en ;
    rdfs:type mso:Sample ;
    mso:has_species obo:NCIT_C14225 .

mso:Sample_v3.4_mm10 rdfs:label "mm10"@en ;
    rdfs:type mso:Sample ;
    mso:has_species obo:NCIT_C45247 .

mso:Sample_v3.4_mm9 rdfs:label "mm9"@en ;
    rdfs:type mso:Sample ;
    mso:has_species obo:NCIT_C45247 .

mso:Sample_v3.4_rn6 rdfs:label "rn6"@en ;
    rdfs:type mso:Sample ;
    mso:has_species obo:NCIT_C14266 .

mso:causes a owl:ObjectProperty ;
    rdfs:comment "An etiology causes cancer"@en ;
    rdfs:domain mso:Etiology ;
    rdfs:range mso:Tumor ;
    rdfs:subPropertyOf mso:is_associated_with ;
    owl:propertyDisjointWith mso:occurs_with .

mso:contributes_to a owl:ObjectProperty ;
    rdfs:domain mso:Mutation,
        mso:Sample ;
    rdfs:subPropertyOf owl:topObjectProperty .

mso:hasMedianMutationPerMb a owl:DatatypeProperty ;
    rdfs:subPropertyOf mso:hasValue .

mso:hasName a owl:DatatypeProperty .

mso:hasOrigin a owl:DatatypeProperty ;
    rdfs:comment "Where does this sample come from? Is it a reference genome, an actual sample, etc?"@en ;
    rdfs:domain mso:Sample ;
    rdfs:range xsd:string .

mso:hasProportion a owl:DatatypeProperty ;
    rdfs:subPropertyOf mso:hasFloatValue .

mso:has_immediate_part a owl:ObjectProperty ;
    rdfs:subPropertyOf mso:has_part .

mso:has_median_0.05_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 0.05 .

mso:has_median_0.0_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 0.0 .

mso:has_median_0.1_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 0.1 .

