prov:category a owl:AnnotationProperty .

prov:component a owl:AnnotationProperty .

prov:inverse a owl:AnnotationProperty .

prov:qualifiedForm a owl:AnnotationProperty .

<https://computationalcancerbiology.uni-koeln.de/mso> a owl:Ontology ;
    rdfs:label "mso"@en,
        "mutational signature ontology"@en ;
    rdfs:comment "This is an ontology describing what mutational signatures are, which properties they have, and how they interact with genomic information, treatments, and cancer types"@en .

mso:CN a owl:Class ;
    rdfs:label "CN Signature"@en ;
    rdfs:comment "Copy number signatures" ;
    rdfs:subClassOf mso:MutationalSignature .

mso:CN_probability a owl:Class ;
    rdfs:label "CN_probability"@en ;
    rdfs:subClassOf mso:MutationProbability .

mso:COSMIC_NGS_technique_unclear-evidence a mso:COSMIC_NGS_technique ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_NGS_technique_valid-evidence a mso:COSMIC_NGS_technique ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_aetiology_artifact-evidence a mso:COSMIC_aetiology ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_artifact-evidence .

