obo:NCIT_C14266 a owl:NamedIndividual,
        mso:Species ;
    rdfs:label "rattus norvegicus"@en .

prov:hadPrimarySource a owl:ObjectProperty ;
    rdfs:label "hadPrimarySource" ;
    rdfs:domain prov:Entity,
        mso:Observation ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity,
        mso:Evidence ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    prov:category "expanded" ;
    prov:component "derivations" ;
    prov:inverse "wasPrimarySourceOf" ;
    prov:qualifiedForm prov:PrimarySource,
        prov:qualifiedPrimarySource .

mso:COSMIC_data_properties a owl:DatatypeProperty ;
    rdfs:subPropertyOf owl:topDataProperty .

mso:COSMIC_version_v3.3 rdfs:label "v3.3"@en ;
    rdfs:type mso:COSMIC_version .

mso:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "Supporting Literature"@en .

mso:Range a owl:Class ;
    rdfs:subClassOf mso:Location .

mso:SV a owl:Class ;
    rdfs:label "SV Signature"@en ;
    rdfs:comment "Structural Variation signature"@en ;
    rdfs:subClassOf mso:MutationalSignature .

mso:Treatment a owl:Class .

mso:has_part a owl:ObjectProperty ;
    rdfs:label "has_part"@en ;
    rdfs:comment """Implemented according to

https://www.w3.org/2001/sw/BestPractices/OEP/SimplePartWhole/"""@en ;
    rdfs:domain mso:MutationalSignature ;
    rdfs:range mso:MutationProbability ;
    owl:inverseOf mso:part_of .

mso:occurs_with a owl:ObjectProperty ;
    rdfs:domain mso:Etiology ;
    rdfs:range mso:MutationalSignature ;
    rdfs:subPropertyOf mso:is_associated_with .

