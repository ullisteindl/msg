    mso:hasMedianMutationPerMb 0.25 .

mso:has_median_0.5_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 0.5 .

mso:has_median_1.0_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 1.0 .

mso:has_median_10.0_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 10.0 .

mso:has_median_2.5_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 2.5 .

mso:has_median_25.0_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 25.0 .

mso:has_median_5.0_mutations_in rdfs:type mso:has_median_mutations_in ;
    mso:hasMedianMutationPerMb 5.0 .

mso:has_signature_proportion_0.1 rdfs:type mso:has_signature_proportion ;
    mso:has_proportion "0.1"^^xsd:float .

mso:has_signature_proportion_0.2 rdfs:type mso:has_signature_proportion ;
    mso:has_proportion "0.2"^^xsd:float .

