    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_aetiology_valid-evidence a mso:COSMIC_aetiology ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_different_variant_callers_unclear-evidence a mso:COSMIC_different_variant_callers ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_different_variant_callers_valid-evidence a mso:COSMIC_different_variant_callers ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_experimental_evidence_artifact-evidence a mso:COSMIC_experimental_evidence ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_artifact-evidence .

mso:COSMIC_experimental_evidence_unclear-evidence a mso:COSMIC_experimental_evidence ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_experimental_evidence_valid-evidence a mso:COSMIC_experimental_evidence ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_experimental_validation_species_artifact-evidence a mso:COSMIC_experimental_validation_species ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_artifact-evidence .

mso:COSMIC_experimental_validation_species_unclear-evidence a mso:COSMIC_experimental_validation_species ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_experimental_validation_species_valid-evidence a mso:COSMIC_experimental_validation_species ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_experimentally_validated a owl:ObjectProperty ;
    rdfs:subPropertyOf mso:COSMIC_obj_properties_with_evidence_strength .

mso:COSMIC_extended_contextual_enrichment_unclear-evidence a mso:COSMIC_extended_contextual_enrichment ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_extended_contextual_enrichment_valid-evidence a mso:COSMIC_extended_contextual_enrichment ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_first_included_in a owl:ObjectProperty ;
    rdfs:domain mso:Observation ;
    rdfs:range mso:COSMIC_version ;
    rdfs:subPropertyOf mso:COSMIC_properties .

mso:COSMIC_has_evidence_strength a owl:AnnotationProperty .

mso:COSMIC_has_version a owl:ObjectProperty ;
    rdfs:domain mso:Observation ;
    rdfs:range mso:COSMIC_version ;
    rdfs:subPropertyOf mso:COSMIC_properties .

mso:COSMIC_identification_study a owl:ObjectProperty ;
    rdfs:subPropertyOf mso:COSMIC_properties .

mso:COSMIC_multiple_sequencing_centres_unclear-evidence a mso:COSMIC_multiple_sequencing_centres ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_multiple_sequencing_centres_valid-evidence a mso:COSMIC_multiple_sequencing_centres ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_replicated_unclear-evidence a mso:COSMIC_replicated ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_replicated_valid-evidence a mso:COSMIC_replicated ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_support_artifact-evidence a mso:COSMIC_support ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_artifact-evidence .

mso:COSMIC_support_unclear-evidence a mso:COSMIC_support ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_unclear-evidence .

mso:COSMIC_support_valid-evidence a mso:COSMIC_support ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

mso:COSMIC_technically_validated a owl:ObjectProperty ;
    rdfs:subPropertyOf mso:COSMIC_obj_properties_with_evidence_strength .

mso:COSMIC_uses_sample a owl:ObjectProperty ;
    rdfs:domain mso:MutationalSignature ;
    rdfs:range mso:Sample ;
    rdfs:subPropertyOf mso:COSMIC_properties .

mso:COSMIC_validated_in_orthogonal_techniques_valid-evidence a mso:COSMIC_validated_in_orthogonal_techniques ;
    mso:COSMIC_has_evidence_strength mso:COSMIC_evidence_strength_valid-evidence .

<https://computationalcancerbiology.uni-koeln.de/mso#COSMIC_version/v3.4> rdfs:label "v3.4"@en ;
    rdfs:type mso:COSMIC_version .

mso:DBM a owl:Class ;
    rdfs:subClassOf mso:Mutation .

mso:DBS a owl:Class ;
    rdfs:label "DBS Signature"@en ;
    rdfs:comment "This signature type covers doublet base pair subtitutions"@en ;
    rdfs:subClassOf mso:MutationalSignature ;
    owl:disjointWith mso:SV .

mso:DBS_probability a owl:Class ;
    rdfs:label "DBS_probability"@en ;
    rdfs:subClassOf mso:MutationProbability .

mso:Gene a owl:Class ;
    rdfs:subClassOf mso:Range .

mso:ID a owl:Class ;
    rdfs:label "ID Signature"@en ;
    rdfs:comment "indel signature"@en ;
    rdfs:subClassOf mso:MutationalSignature .

mso:IDM a owl:Class ;
    rdfs:subClassOf mso:Mutation .

mso:ID_probability a owl:Class ;
    rdfs:label "ID_probability"@en ;
    rdfs:subClassOf mso:MutationProbability .

mso:MutationCatalogue a owl:Class ;
    rdfs:subClassOf mso:Observation .

mso:MutationalExposure a owl:Class ;
    rdfs:subClassOf mso:Observation .

mso:RNA_SBS a owl:Class ;
    rdfs:label "RNA SBS Signature"@en ;
    rdfs:subClassOf mso:MutationalSignature .

mso:RNA_SBS_probability a owl:Class ;
    rdfs:label "RNA_SBS_probability"@en ;
    rdfs:subClassOf mso:MutationProbability .

mso:ReferenceSample a owl:Class ;
    rdfs:label "ReferenceSample"@en ;
    rdfs:comment "e.g. GRCh37,GRCh38,mm9, mm10, rn6"@en ;
    rdfs:subClassOf mso:Sample .

mso:SBM a owl:Class ;
    rdfs:subClassOf mso:Mutation .

